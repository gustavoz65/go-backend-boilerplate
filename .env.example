# Backend boilerplate environment variables
# Copy this file to .env and update values for your environment.

# === PRIMARY ===
APP_PRIMARY_ENV=local

# === SERVER ===
APP_SERVER_PORT=3000
APP_SERVER_READ_TIMEOUT=30
APP_SERVER_WRITE_TIMEOUT=30
APP_SERVER_IDLE_TIMEOUT=60
APP_SERVER_CORS_ALLOWED_ORIGINS=http://localhost:3000

# === DATABASE ===
APP_DATABASE_HOST=localhost
APP_DATABASE_PORT=3306
APP_DATABASE_USER=app
APP_DATABASE_PASSWORD=app_password
APP_DATABASE_DB_NAME=boilerplate
APP_DATABASE_SSL_MODE=disable

# Optional pool settings
# APP_DATABASE_MAX_OPEN_CONNS=25
# APP_DATABASE_MAX_IDLE_CONNS=5
# APP_DATABASE_CONN_MAX_LIFETIME=300
# APP_DATABASE_CONN_MAX_IDLE_TIME=60

# === AUTH ===
APP_AUTH_SECRET_KEY=replace-with-a-strong-secret-key-at-least-32-chars
APP_AUTH_ACCESS_TOKEN_DURATION=15
APP_AUTH_REFRESH_TOKEN_DURATION=168
APP_AUTH_ISSUER=go-backend-boilerplate

# === REDIS ===
APP_REDIS_ADDRESS=localhost:6379
# APP_REDIS_PASSWORD=
# APP_REDIS_DB=0

# === FIREBASE (Optional social login) ===
APP_FIREBASE_ENABLED=false
# APP_FIREBASE_PROJECT_ID=your-project-id
# APP_FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# APP_FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# === INTEGRATIONS ===
# APP_INTEGRATION_RESEND_API_KEY=re_xxxxxxxxxxxxx

# === OBSERVABILITY (Optional) ===
# APP_OBSERVABILITY_SERVICE_NAME=go-backend-boilerplate
# APP_OBSERVABILITY_ENVIRONMENT=local
# APP_OBSERVABILITY_LOGGING_LEVEL=info
# APP_OBSERVABILITY_LOGGING_FORMAT=json
# APP_OBSERVABILITY_NEW_RELIC_LICENSE_KEY=
